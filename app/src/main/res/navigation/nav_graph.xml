<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment android:id="@+id/loginFragment" android:name="com.example.stop_fgastos.presentation.auth.LoginFragment" android:label="Entrar">
        <action android:id="@+id/action_login_to_dashboard" app:destination="@id/dashboardFragment" app:popUpTo="@id/loginFragment" app:popUpToInclusive="true" />
    </fragment>
    <fragment android:id="@+id/dashboardFragment" android:name="com.example.stop_fgastos.presentation.dashboard.DashboardFragment" android:label="Início" />
    <fragment android:id="@+id/transactionsFragment" android:name="com.example.stop_fgastos.presentation.transactions.TransactionsFragment" android:label="Lançamentos" />
    <fragment android:id="@+id/planningFragment" android:name="com.example.stop_fgastos.presentation.planning.PlanningFragment" android:label="Planejar" />
    <fragment android:id="@+id/walletFragment" android:name="com.example.stop_fgastos.presentation.wallet.WalletFragment" android:label="Carteira" />
    <fragment android:id="@+id/moreFragment" android:name="com.example.stop_fgastos.presentation.more.MoreFragment" android:label="Mais">
        <action android:id="@+id/action_more_to_family" app:destination="@id/familyFragment" />
        <action android:id="@+id/action_more_to_shopping" app:destination="@id/shoppingFragment" />
        <action android:id="@+id/action_more_to_calendar" app:destination="@id/calendarFragment" />
        <action android:id="@+id/action_more_to_reports" app:destination="@id/reportsFragment" />
        <action android:id="@+id/action_more_to_settings" app:destination="@id/settingsFragment" />
    </fragment>
    <fragment android:id="@+id/familyFragment" android:name="com.example.stop_fgastos.presentation.family.FamilyFragment" android:label="Família" />
    <fragment android:id="@+id/shoppingFragment" android:name="com.example.stop_fgastos.presentation.shopping.ShoppingFragment" android:label="Compras" />
    <fragment android:id="@+id/calendarFragment" android:name="com.example.stop_fgastos.presentation.calendar.CalendarFragment" android:label="Calendário" />
    <fragment android:id="@+id/reportsFragment" android:name="com.example.stop_fgastos.presentation.reports.ReportsFragment" android:label="Relatórios" />
    <fragment android:id="@+id/settingsFragment" android:name="com.example.stop_fgastos.presentation.settings.SettingsFragment" android:label="Conta" />
</navigation>
