<resources>
    <style name="TextAppearance.StopGastos.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/primary_2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="TextAppearance.StopGastos.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="TextAppearance.StopGastos.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.StopGastos.BodyMuted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Widget.StopGastos.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.StopGastos.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.StopGastos.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.StopGastos.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/danger_soft</item>
        <item name="strokeColor">@color/danger</item>
        <item name="android:textColor">@color/expense</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.StopGastos.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary_2</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.StopGastos.Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
