<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MOVIMENTAÇÕES DO MÊS"
        android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.StopGastos.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <EditText
                android:id="@+id/transactions_search"
                style="@style/Widget.StopGastos.Input"
                android:layout_width="0dp"
                android:layout_height="@dimen/control_height"
                android:layout_weight="2"
                android:hint="Buscar descrição ou categoria..."
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />

            <Spinner
                android:id="@+id/transactions_type_filter"
                android:layout_width="0dp"
                android:layout_height="@dimen/control_height"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:popupBackground="@color/surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/transactions_add"
                style="@style/Widget.StopGastos.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="+ Adicionar" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ENTRADAS" android:textAppearance="@style/TextAppearance.StopGastos.Caption" />
                <TextView android:id="@+id/transactions_income" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.StopGastos.CardValue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space android:layout_width="10dp" android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAÍDAS" android:textAppearance="@style/TextAppearance.StopGastos.Caption" />
                <TextView android:id="@+id/transactions_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.StopGastos.CardValue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space android:layout_width="10dp" android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SALDO" android:textAppearance="@style/TextAppearance.StopGastos.Caption" />
                <TextView android:id="@+id/transactions_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.StopGastos.CardValue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space android:layout_width="10dp" android:layout_height="1dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LANÇAMENTOS" android:textAppearance="@style/TextAppearance.StopGastos.Caption" />
                <TextView android:id="@+id/transactions_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.StopGastos.CardValue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transactions_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />
</LinearLayout>