<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/content_bottom_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANÁLISE DO MÊS"
            android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/report_previous" style="@style/Widget.StopGastos.Button.Text" android:layout_width="42dp" android:layout_height="42dp" android:minWidth="0dp" android:text="‹" android:textSize="22sp" />
                <TextView android:id="@+id/report_month" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton android:id="@+id/report_next" style="@style/Widget.StopGastos.Button.Text" android:layout_width="42dp" android:layout_height="42dp" android:minWidth="0dp" android:text="›" android:textSize="22sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StopGastos.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RESUMO" android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />
                    <TextView android:id="@+id/report_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/report_export"
                        style="@style/Widget.StopGastos.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Exportar relatório" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space android:layout_width="12dp" android:layout_height="1dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StopGastos.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CATEGORIAS" android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Para onde foi seu dinheiro" android:textAppearance="@style/TextAppearance.StopGastos.Section" />
                    <com.example.stop_fgastos.presentation.reports.FinanceBarChartView android:id="@+id/report_chart" android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginTop="10dp" />
                    <TextView android:id="@+id/report_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/bg_input" android:gravity="center" android:padding="16dp" android:text="Nenhuma despesa por categoria neste mês." android:textColor="@color/text_muted" android:textSize="10sp" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="DETALHES"
            android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/report_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>