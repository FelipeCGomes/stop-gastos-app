<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding" android:paddingTop="20dp" android:paddingBottom="8dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STOP GASTOS" android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />
    <TextView android:id="@+id/module_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.StopGastos.Title" />
    <TextView android:id="@+id/module_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.StopGastos.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
        <Spinner android:id="@+id/module_spinner" android:layout_width="match_parent" android:layout_height="50dp" android:paddingHorizontal="14dp" android:popupBackground="@color/surface_2" />
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/module_add" style="@style/Widget.StopGastos.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Adicionar" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/module_recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:clipToPadding="false" android:paddingBottom="14dp" />
</LinearLayout>
