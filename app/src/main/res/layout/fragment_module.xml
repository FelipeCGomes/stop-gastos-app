<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp">
    <TextView android:id="@+id/module_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/module_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" />
    <Spinner android:id="@+id/module_spinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/module_add" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Adicionar" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/module_recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" />
</LinearLayout>
