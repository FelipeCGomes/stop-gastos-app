<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Relatórios" android:textSize="26sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/report_previous" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹" />
        <TextView android:id="@+id/report_month" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="18sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/report_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" />
    </LinearLayout>
    <TextView android:id="@+id/report_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" />
    <com.example.stop_fgastos.presentation.reports.FinanceBarChartView android:id="@+id/report_chart" android:layout_width="match_parent" android:layout_height="190dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/report_export" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Exportar CSV" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/report_recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
