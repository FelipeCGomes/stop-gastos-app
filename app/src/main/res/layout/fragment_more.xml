<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/content_bottom_padding">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CENTRAL" android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Mais recursos" android:textAppearance="@style/TextAppearance.StopGastos.Section" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Acesse os módulos complementares do Stop Gastos." android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />
        <com.google.android.material.button.MaterialButton android:id="@+id/more_family" style="@style/Widget.StopGastos.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:gravity="start|center_vertical" android:text="👥   Família e convites" />
        <com.google.android.material.button.MaterialButton android:id="@+id/more_shopping" style="@style/Widget.StopGastos.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:gravity="start|center_vertical" android:text="🛒   Listas de compras" />
        <com.google.android.material.button.MaterialButton android:id="@+id/more_calendar" style="@style/Widget.StopGastos.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:gravity="start|center_vertical" android:text="🗓   Calendário financeiro" />
        <com.google.android.material.button.MaterialButton android:id="@+id/more_reports" style="@style/Widget.StopGastos.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:gravity="start|center_vertical" android:text="📊   Relatórios e exportação" />
        <com.google.android.material.button.MaterialButton android:id="@+id/more_settings" style="@style/Widget.StopGastos.Button.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="7dp" android:gravity="start|center_vertical" android:text="⚙   Conta e notificações" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
