<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/content_bottom_padding">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_gradient"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESUMO DO MÊS"
                    android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

                <TextView
                    android:id="@+id/dashboard_greeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Resumo do mês"
                    android:textColor="@color/hero_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dashboard_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_add_recurring"
                    style="@style/Widget.StopGastos.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:text="+  Custo fixo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_open_reports"
                    style="@style/Widget.StopGastos.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:text="Ver relatório" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_alert_card"
            style="@style/Widget.StopGastos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="13dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="11dp">

                <TextView
                    android:id="@+id/dashboard_alert_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/income"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dashboard_alert_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StopGastos.Card"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="end|top"
                        android:alpha="0.14"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/income"
                        android:translationX="28dp"
                        android:translationY="-28dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_input"
                                android:gravity="center"
                                android:text="↗"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:text="RECEITAS"
                                android:textColor="@color/text_muted"
                                android:textSize="8sp"
                                android:letterSpacing="0.06" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dashboard_income"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Oculto"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dashboard_income_delta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:textColor="@color/income"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StopGastos.Card"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="end|top"
                        android:alpha="0.14"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/expense"
                        android:translationX="28dp"
                        android:translationY="-28dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_input"
                                android:gravity="center"
                                android:text="↘"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:text="DESPESAS"
                                android:textColor="@color/text_muted"
                                android:textSize="8sp"
                                android:letterSpacing="0.06" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dashboard_expense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="R$ 0,00"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dashboard_expense_delta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:textColor="@color/text_muted"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StopGastos.Card"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="end|top"
                        android:alpha="0.14"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/primary"
                        android:translationX="28dp"
                        android:translationY="-28dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_input"
                                android:gravity="center"
                                android:text="≈"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:text="SALDO"
                                android:textColor="@color/text_muted"
                                android:textSize="8sp"
                                android:letterSpacing="0.06" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dashboard_balance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="R$ 0,00"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dashboard_savings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:textColor="@color/income"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StopGastos.Card"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="end|top"
                        android:alpha="0.14"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/warning"
                        android:translationX="28dp"
                        android:translationY="-28dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_input"
                                android:gravity="center"
                                android:text="◷"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:text="MÉDIA DIÁRIA"
                                android:textColor="@color/text_muted"
                                android:textSize="8sp"
                                android:letterSpacing="0.06" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dashboard_daily"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="R$ 0,00"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dashboard_projection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:textColor="@color/text_muted"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EVOLUÇÃO"
                            android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Receitas e despesas nos últimos 6 meses"
                            android:textAppearance="@style/TextAppearance.StopGastos.Section" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Despesas"
                            android:textColor="@color/expense"
                            android:textSize="8sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="● Receitas"
                            android:textColor="@color/income"
                            android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.example.stop_fgastos.presentation.dashboard.FinanceTrendChartView
                    android:id="@+id/dashboard_trend_chart"
                    android:layout_width="match_parent"
                    android:layout_height="215dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SAÚDE FINANCEIRA"
                            android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

                        <TextView
                            android:id="@+id/dashboard_health_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Seu score"
                            android:textAppearance="@style/TextAppearance.StopGastos.Section" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dashboard_health_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="0/100"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dashboard_health_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/dashboard_health_progress"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    app:indicatorColor="@color/primary"
                    app:trackColor="@color/surface_3"
                    app:trackCornerRadius="7dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ÚLTIMOS LANÇAMENTOS"
            android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

        <TextView
            android:id="@+id/dashboard_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:padding="20dp"
            android:text="Nenhum lançamento neste mês."
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dashboard_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
