<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <View android:layout_width="260dp" android:layout_height="260dp" android:layout_marginStart="-100dp" android:layout_marginTop="-90dp" android:background="@drawable/bg_orb_primary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <View android:layout_width="240dp" android:layout_height="240dp" android:layout_marginEnd="-90dp" android:layout_marginBottom="-80dp" android:background="@drawable/bg_orb_accent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.StopGastos.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="18dp"
        app:strokeColor="@color/line_strong"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp">
            <ImageView android:layout_width="58dp" android:layout_height="58dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_splash" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="CONTROLE INTELIGENTE" android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Seu dinheiro, mais claro." android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/login_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Controle financeiro pessoal e familiar, sincronizado com segurança." android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" android:lineSpacingExtra="3dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_google" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="28dp" android:backgroundTint="@color/white" android:text="G  Entrar com Google" android:textAllCaps="false" android:textColor="#202124" android:textStyle="bold" app:cornerRadius="13dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/bg_indicator" android:backgroundTint="@color/accent" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:text="Firebase protegido • sincronização em nuvem" android:textColor="@color/text_muted" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/login_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textColor="@color/text_muted" android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
