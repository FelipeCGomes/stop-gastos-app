<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/top_navigation_card"
        style="@style/Widget.StopGastos.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/line_strong"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/top_navigation"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@color/transparent"
            android:paddingEnd="6dp"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/text_primary"
            app:titleTextColor="@color/text_primary"
            app:titleTextAppearance="@style/TextAppearance.StopGastos.Section" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toBottomOf="@id/top_navigation_card"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_navigation_card"
        style="@style/Widget.StopGastos.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="9dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/line_strong"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="@color/transparent"
            app:itemActiveIndicatorColor="@color/primary_soft"
            app:itemHorizontalTranslationEnabled="false"
            app:itemIconSize="21dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextAppearanceActive="@style/TextAppearance.StopGastos.Nav.Active"
            app:itemTextAppearanceInactive="@style/TextAppearance.StopGastos.Nav"
            app:itemTextColor="@color/nav_item_color"
            app:itemRippleColor="@color/primary_soft"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_bottom_navigation" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
