<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PREFERÊNCIAS" android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Personalize seu app" android:textAppearance="@style/TextAppearance.StopGastos.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Aparência, notificações e segurança da conta." android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Aparência" android:textAppearance="@style/TextAppearance.StopGastos.Section" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Escolha como o Stop Gastos deve aparecer neste aparelho." android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/settings_theme_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_theme_system"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Sistema"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_theme_light"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Claro"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_theme_dark"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Escuro"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONTA CONECTADA" android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />
                <TextView android:id="@+id/settings_user" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Notificações" android:textAppearance="@style/TextAppearance.StopGastos.Section" />
        <com.google.android.material.button.MaterialButton android:id="@+id/settings_enable_notifications" style="@style/Widget.StopGastos.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="🔔  Ativar notificações" />
        <com.google.android.material.button.MaterialButton android:id="@+id/settings_disable_notifications" style="@style/Widget.StopGastos.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Silenciar neste aparelho" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Sessão" android:textAppearance="@style/TextAppearance.StopGastos.Section" />
        <com.google.android.material.button.MaterialButton android:id="@+id/settings_sign_out" style="@style/Widget.StopGastos.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Sair da conta" />
        <com.google.android.material.button.MaterialButton android:id="@+id/settings_delete_account" style="@style/Widget.StopGastos.Button.Danger" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Excluir minha conta" />

        <TextView android:id="@+id/settings_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:padding="12dp" android:textColor="@color/text_muted" android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
