<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/transaction_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Novo lançamento"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Preencha apenas o necessário. Os dados financeiros ficam organizados automaticamente."
            android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="INFORMAÇÕES PRINCIPAIS"
            android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tx_description_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Descrição">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tx_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tx_amount_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Valor total"
            app:prefixText="R$ ">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tx_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Data (dd/MM/aa)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tx_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="date"
                android:maxLength="10"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="CLASSIFICAÇÃO E PAGAMENTO"
            android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tipo"
            android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="4dp"
            app:cardElevation="0dp">

            <Spinner
                android:id="@+id/tx_type"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:popupBackground="@color/surface" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Forma de pagamento"
            android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="4dp"
            app:cardElevation="0dp">

            <Spinner
                android:id="@+id/tx_payment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:popupBackground="@color/surface" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Categoria"
            android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="4dp"
            app:cardElevation="0dp">

            <Spinner
                android:id="@+id/tx_category"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:popupBackground="@color/surface" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Conta"
            android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.StopGastos.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:layout_marginTop="4dp"
            app:cardElevation="0dp">

            <Spinner
                android:id="@+id/tx_account"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:popupBackground="@color/surface" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/tx_credit_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Cartão"
                android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StopGastos.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height"
                android:layout_marginTop="4dp"
                app:cardElevation="0dp">

                <Spinner
                    android:id="@+id/tx_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:popupBackground="@color/surface" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Parcelas">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tx_installments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="DETALHES OPCIONAIS"
            android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Tags">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tx_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Observações">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tx_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tx_cancel"
                style="@style/Widget.StopGastos.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/control_height"
                android:layout_weight="1"
                android:text="Cancelar" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tx_save"
                style="@style/Widget.StopGastos.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/control_height"
                android:layout_weight="1"
                android:text="Salvar lançamento" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
