<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding" android:paddingTop="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMPRA INTELIGENTE" android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Listas de compras" android:textAppearance="@style/TextAppearance.StopGastos.Title" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Compare mercados e encontre onde economizar." android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.StopGastos.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
        <Spinner android:id="@+id/shopping_list_spinner" android:layout_width="match_parent" android:layout_height="50dp" android:paddingHorizontal="14dp" android:popupBackground="@color/surface_2" />
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/shopping_add_list" style="@style/Widget.StopGastos.Button.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+ Nova lista" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/shopping_edit_list" style="@style/Widget.StopGastos.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Editar" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/shopping_add_item" style="@style/Widget.StopGastos.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+ Item" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/shopping_delete_list" style="@style/Widget.StopGastos.Button.Danger" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Excluir lista" />
    </LinearLayout>
    <TextView android:id="@+id/shopping_comparison" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_hero_gradient" android:padding="14dp" android:textColor="@color/text_primary" android:textSize="12sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/shopping_recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:clipToPadding="false" android:paddingBottom="14dp" />
</LinearLayout>
