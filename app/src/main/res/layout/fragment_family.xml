<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="8dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FAMÍLIA" android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.StopGastos.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
            <TextView android:id="@+id/family_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sua família financeira" android:textAppearance="@style/TextAppearance.StopGastos.Section" />
            <TextView android:id="@+id/family_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView style="@style/Widget.StopGastos.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="9dp">
            <Spinner android:id="@+id/family_mode" android:layout_width="match_parent" android:layout_height="@dimen/control_height" android:background="@drawable/bg_input" android:paddingStart="10dp" android:paddingEnd="10dp" android:popupBackground="@color/surface" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/family_primary_action" style="@style/Widget.StopGastos.Button.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Criar família" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/family_secondary_action" style="@style/Widget.StopGastos.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Atualizar" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="MEMBROS E CONVITES" android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/family_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/family_leave"
        style="@style/Widget.StopGastos.Button.Danger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Sair da família" />
</LinearLayout>
