<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding" android:paddingEnd="@dimen/screen_padding" android:paddingTop="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMPARTILHADO" android:textAppearance="@style/TextAppearance.StopGastos.Eyebrow" />
    <TextView android:id="@+id/family_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Família" android:textAppearance="@style/TextAppearance.StopGastos.Title" />
    <TextView android:id="@+id/family_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.StopGastos.BodyMuted" />
    <com.google.android.material.card.MaterialCardView style="@style/Widget.StopGastos.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
        <Spinner android:id="@+id/family_mode" android:layout_width="match_parent" android:layout_height="50dp" android:paddingHorizontal="14dp" android:popupBackground="@color/surface_2" />
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/family_primary_action" style="@style/Widget.StopGastos.Button.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Criar família" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/family_secondary_action" style="@style/Widget.StopGastos.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Convidar" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/family_recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="11dp" android:clipToPadding="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/family_leave" style="@style/Widget.StopGastos.Button.Danger" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="10dp" android:text="Sair da família" />
</LinearLayout>
